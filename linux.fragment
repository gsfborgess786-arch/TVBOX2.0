# Complementa o multi_v7_defconfig (que ja traz boa parte do RK3066)
CONFIG_ARCH_ROCKCHIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# SD card
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
# video (HDMI + GPU Mali-400 via Lima)
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_DRM_LIMA=y
CONFIG_DRM_FBDEV_EMULATION=y
# audio pelo HDMI
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
CONFIG_SND_SOC_HDMI_CODEC=y
# USB
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_DWC2=y
CONFIG_PHY_ROCKCHIP_USB=y
# Wi-Fi: os chips mais comuns em sticks (o seu pode ser outro, veja o README)
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTL_CARDS=y
CONFIG_RTL8192CU=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
# entrada: teclado, mouse, controle USB, receptor IR
CONFIG_INPUT_EVDEV=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_JOYDEV=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_IR_NEC_DECODER=y
CONFIG_LIRC=y
